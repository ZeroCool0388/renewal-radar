        { "type": "equals", "path": "daysToNotice", "value": 240 },
        { "type": "equals", "path": "status", "value": "OK" },
        { "type": "equals", "path": "trap", "value": false },
        { "type": "equals", "path": "governingLaw", "value": "Scotland" },
