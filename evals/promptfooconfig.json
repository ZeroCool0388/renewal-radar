        { "type": "equals", "path": "endDate", "value": "2026-10-30" },
        { "type": "equals", "path": "noticePeriodDays", "value": 30 },
        { "type": "equals", "path": "autoRenew", "value": true },
        { "type": "equals", "path": "renewalTermMonths", "value": 12 },
        { "type": "equals", "path": "liabilityCapCustomer", "value": "24 months of fees" },
