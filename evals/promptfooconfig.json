        { "type": "equals", "path": "daysToRenew", "value": null }
      ]
    },
    {
      "description": "Unlabelled junk text does not invent commercial terms",
      "vars": {
        "task": "rules",
        "name": "junk.txt",
        "text": "SYNTHETIC DEMO DATA. Fictional company. Not real.\nasdf qwerty nothing commercial here 12345."
      },
      "assert": [
        { "type": "equals", "path": "mode", "value": "demo" },
