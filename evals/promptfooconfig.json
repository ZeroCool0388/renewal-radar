        { "type": "equals", "path": "autoRenew", "value": false },
        { "type": "equals", "path": "noticePeriodDays", "value": 90 },
        { "type": "equals", "path": "daysToRenew", "value": 240 },
        { "type": "equals", "path": "status", "value": "OK" },
        { "type": "equals", "path": "trap", "value": false },
